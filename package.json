{
  "name":"agent-security-pilot",
  "version":"0.1.0",
  "private":true,
  "description":"Agent identity and permission risk pilot",
  "main":"dist/main/main.js",
  "scripts":{
    "dev":"vite",
    "build":"tsc -b && vite build",
    "typecheck":"tsc --noEmit",
    "package":"electron-builder",
    "lint":"eslint .",
    "test":"vitest run"
  },
  "dependencies":{
    "@azure/msal-node":"^3.8.1",
    "@vitejs/plugin-react":"^4.7.0",
    "electron":"^37.2.6",
    "react":"^19.1.1",
    "react-dom":"^19.1.1",
    "zod":"^4.0.17"
  },
  "devDependencies":{
    "@types/node":"^24.2.0",
    "@types/react":"^19.1.9",
    "@types/react-dom":"^19.1.7",
    "electron-builder":"^26.0.12",
    "typescript":"^5.9.2",
    "vite":"^7.1.2",
    "vitest":"^3.2.4"
  },
  "build":{
    "appId":"com.agentsecurity.pilot",
    "productName":"Agent Security Pilot",
    "files":["dist/**"],
    "win":{"target":["nsis"]},
    "mac":{"target":["dmg"]},
    "linux":{"target":["AppImage"]}
  }
}
